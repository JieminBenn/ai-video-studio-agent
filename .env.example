# Studio Agent — API keys. Copy to `.env` (gitignored) and fill in.
# M0 runs end-to-end with --fake and needs NONE of these.

# OpenAI-compatible LLM profiles. DEEPSEEK_API_KEY is the cheap story-planning default;
# OPENAI_API_KEY is for hosted APIs; VLLM_API_KEY is optional for cloud open-weight
# workers that require a bearer token.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
VLLM_API_KEY=

# Google Gemini / Imagen image generation and Gemini-based video QC.
GEMINI_API_KEY=

# OpenAI GPT Image 2 image generation also uses OPENAI_API_KEY.

# xAI Grok chat, Imagine image generation/editing, video generation, and frame QC.
XAI_API_KEY=

# LLM / agent (story, script, plot expansion, future VLM review)
ANTHROPIC_API_KEY=

# fal is wired for paid reference-to-video smoke tests; Replicate is a future candidate.
FAL_KEY=
REPLICATE_API_TOKEN=

# Voice / music / SFX
ELEVENLABS_API_KEY=

# DouBao / Volcengine Ark. ARK_API_KEY is wired for direct Chinese-price
# Seedance video and Seedream image generation. BYTEPLUS_ARK_API_KEY is wired for
# international BytePlus ModelArk video/image smoke-test profiles.
DOUBAO_API_KEY=
ARK_API_KEY=
BYTEPLUS_ARK_API_KEY=

# You can add any extra provider-specific test keys below.
